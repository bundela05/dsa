   "source": [
    "rem dublicaters from sorted array\n",
    "return size of the remaining arary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "878041e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def remDub(arr):\n",
    "    i = 0\n",
    "    for j in range(1,len(arr)):\n",
    "        if arr[i]!= arr[j]:\n",
    "            i+=1\n",
    "            arr[i] = arr[j]\n",
    "    return i+1 , arr[:i+1]"
   ]
  },
